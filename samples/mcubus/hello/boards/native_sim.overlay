/* &i2c0 is the multi-master port of native_sim (ws-zephyr/drivers/i2c/i2c_mm_emul.c):
 * the processes with the same bus-id share one bus. Its children are the MCUs
 * on the bus, the same for both images; which of them an image is comes from
 * CMake: MCUBUS_SELF_LABEL is mcu_<NODE>.
 */

/ {
	chosen {
		zephyr,mcubus-self = &MCUBUS_SELF_LABEL;
	};
};

&i2c0 {
	compatible = "zephyr,i2c-mm-emul";
	bus-id = <2>;

	mcu_a: mcu-a@10 {
		compatible = "zephyr,mcubus-node";
		reg = <0x10>;
	};

	mcu_b: mcu-b@11 {
		compatible = "zephyr,mcubus-node";
		reg = <0x11>;
	};
};
