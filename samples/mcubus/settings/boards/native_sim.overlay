/* native_sim ships &i2c0 as a stock emulated controller; here it is the
 * multi-master port (ws-zephyr/drivers/i2c/i2c_mm_emul.c), wired to the other
 * MCUs. Its children are the MCUs on the bus: the address plan, in one place.
 * Which of them an image is comes from CMake: MCUBUS_SELF_LABEL is mcu_<NODE>.
 */

/ {
	chosen {
		zephyr,mcubus-self = &MCUBUS_SELF_LABEL;
	};
};

&i2c0 {
	compatible = "zephyr,i2c-mm-emul";
	bus-id = <0>;

	/* The MCUs are processes that the host scheduler wakes up within about a
	 * millisecond of each other: that is what counts as "at the same moment"
	 */
	start-window-us = <2000>;

	mcu_a: mcu-a@10 {
		compatible = "zephyr,mcubus-node";
		reg = <0x10>;
	};

	mcu_b: mcu-b@11 {
		compatible = "zephyr,mcubus-node";
		reg = <0x11>;
	};

	mcu_c: mcu-c@12 {
		compatible = "zephyr,mcubus-node";
		reg = <0x12>;
	};
};
