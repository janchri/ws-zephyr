config UART_MCUBUS
	bool "UART over the multi-master I2C bus"
	default y
	depends on DT_HAS_ZEPHYR_MCUBUS_UART_ENABLED
	depends on MCUBUS
	select SERIAL_HAS_DRIVER
	select SERIAL_SUPPORT_INTERRUPT
	select UART_INTERRUPT_DRIVEN
	select RING_BUFFER
	help
	  A byte stream to one other MCU on the bus, as a UART
	  (dts/bindings/mcubus/zephyr,mcubus-uart.yaml).

if UART_MCUBUS

config UART_MCUBUS_RX_BUF_SIZE
	int "Receive buffer of each UART"
	default 256

config UART_MCUBUS_TX_BUF_SIZE
	int "Transmit buffer of each UART"
	default 256

config UART_MCUBUS_CHUNK
	int "Most bytes in one request"
	default 32
	range 1 125
	help
	  Every request is a transfer of its own on the bus: longer ones take
	  less overhead, shorter ones hold the bus for less time. A request
	  (cmd, source, chunk) must fit CONFIG_MCUBUS_MSG_MAX.

config UART_MCUBUS_POLL_MS
	int "Retry interval while the peer's buffer is full or the bus is taken"
	default 5

config UART_MCUBUS_THREAD_PRIORITY
	int "Priority of the thread that sends and runs the UART callbacks"
	default 2

config UART_MCUBUS_THREAD_STACK_SIZE
	int "Stack size of that thread"
	default 1536

endif # UART_MCUBUS
