config UART_MCUBUS
	bool "UART over the mcubus"
	default y
	depends on DT_HAS_ZEPHYR_MCUBUS_UART_ENABLED
	depends on MCUBUS
	select SERIAL_HAS_DRIVER
	select SERIAL_SUPPORT_INTERRUPT
	select UART_INTERRUPT_DRIVEN
	select RING_BUFFER
	help
	  See dts/bindings/mcubus/zephyr,mcubus-uart.yaml.

if UART_MCUBUS

config UART_MCUBUS_RX_BUF_SIZE
	int "Receive buffer of each UART"
	default 256

config UART_MCUBUS_TX_BUF_SIZE
	int "Transmit buffer of each UART"
	default 256

config UART_MCUBUS_CHUNK
	int "Most bytes in one request"
	default 32
	range 1 252
	help
	  Longer chunks cost less overhead, shorter ones hold the bus for less
	  time. Up to MCUBUS_DATA_MAX.

config UART_MCUBUS_POLL_MS
	int "Retry interval while the peer is full or the bus is taken, in ms"
	default 5

config UART_MCUBUS_THREAD_PRIORITY
	int "Priority of the UART thread"
	default 2

config UART_MCUBUS_THREAD_STACK_SIZE
	int "Stack size of the UART thread"
	default 1536

endif # UART_MCUBUS

# Interrupt-driven, as MCUmgr's shell transport needs; Zephyr defaults to polling
# on native_sim
DT_CHOSEN_SHELL_UART := zephyr,shell-uart
DT_COMPAT_MCUBUS_UART := zephyr,mcubus-uart

configdefault SHELL_BACKEND_SERIAL_INTERRUPT_DRIVEN
	default y if UART_MCUBUS && $(dt_chosen_has_compat,$(DT_CHOSEN_SHELL_UART),$(DT_COMPAT_MCUBUS_UART))
