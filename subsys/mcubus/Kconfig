DT_CHOSEN_MCUBUS_SELF := zephyr,mcubus-self

menuconfig MCUBUS
	bool "Requests between the MCUs on a multi-master I2C bus"
	default y if $(dt_chosen_enabled,$(DT_CHOSEN_MCUBUS_SELF))
	depends on I2C
	select I2C_MM
	help
	  This MCU (/chosen zephyr,mcubus-self) serves requests of the other
	  MCUs, from boot on, and sends them requests, over the multi-master
	  I2C link (CONFIG_I2C_MM). Services: ping (MCUBUS_PING), settings
	  (MCUBUS_SETTINGS) and a UART (UART_MCUBUS). See <mcubus/mcubus.h>.

if MCUBUS

config MCUBUS_INIT_PRIORITY
	int "Init priority, after the I2C driver"
	default 60

config MCUBUS_SHELL
	bool "Shell commands: mcubus stats, and those of the services"
	default y
	depends on SHELL

config MCUBUS_PING
	bool "Ping service: does an MCU answer, with which protocol"
	default y
	help
	  Every MCU should answer it: it is how the others check that it speaks
	  their protocol. See <mcubus/ping.h>.

rsource "Kconfig.settings"

module = MCUBUS
module-str = mcubus
source "subsys/logging/Kconfig.template.log_config"

endif # MCUBUS
