DT_CHOSEN_MCUBUS_SELF := zephyr,mcubus-self

menuconfig MCUBUS
	bool "Requests between equal MCUs on a multi-master I2C bus"
	default y if $(dt_chosen_enabled,$(DT_CHOSEN_MCUBUS_SELF))
	depends on I2C
	select I2C_MM
	help
	  On with /chosen zephyr,mcubus-self. See <mcubus/mcubus.h>.

if MCUBUS

config MCUBUS_INIT_PRIORITY
	int "Init priority"
	default 60
	help
	  After the I2C driver.

config MCUBUS_SHELL
	bool "Shell commands"
	default y
	depends on SHELL

config MCUBUS_PING
	bool "Ping service"
	default y
	help
	  Every MCU should answer it. See <mcubus/ping.h>.

rsource "Kconfig.settings"

module = MCUBUS
module-str = mcubus
source "subsys/logging/Kconfig.template.log_config"

endif # MCUBUS
