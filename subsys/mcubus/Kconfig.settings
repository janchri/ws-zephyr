menuconfig MCUBUS_SETTINGS
	bool "Settings service"
	depends on SETTINGS
	select SETTINGS_RUNTIME
	help
	  See <mcubus/settings.h>.

if MCUBUS_SETTINGS

config MCUBUS_SETTINGS_KEY_MAX
	int "Longest key, NUL included"
	default 24
	range 2 128

config MCUBUS_SETTINGS_VALUE_MAX
	int "Longest value"
	default 16
	range 1 251
	help
	  Op, key and value of a set must fit MCUBUS_DATA_MAX.

endif # MCUBUS_SETTINGS
