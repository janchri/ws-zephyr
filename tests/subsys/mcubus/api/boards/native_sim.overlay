/* One MCU alone on the bus: requests to itself, raw transfers to its own target
 * (the emulated port can address it), and NACKs from an empty address. A bus-id
 * of its own, so that the samples (bus 0 and 1) do not get in the way.
 */

/ {
	chosen {
		zephyr,mcubus-self = &mcu_self;
	};
};

&i2c0 {
	compatible = "zephyr,i2c-mm-emul";
	bus-id = <42>;
	loopback;

	mcu_self: mcu@20 {
		compatible = "zephyr,mcubus-node";
		reg = <0x20>;
	};
};
