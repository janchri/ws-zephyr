/* The bus on native_sim (zephyr,i2c-mm-emul); MCUBUS_SELF_LABEL is mcu_<NODE> */

/ {
	chosen {
		zephyr,mcubus-self = &MCUBUS_SELF_LABEL;
	};
};

&i2c0 {
	compatible = "zephyr,i2c-mm-emul";
	bus-id = <4>;

	/* The MCUs are processes that the host scheduler wakes up within about a
	 * millisecond of each other: that is what counts as "at the same moment"
	 */
	start-window-us = <2000>;

	mcu_a: mcu-a@10 {
		compatible = "zephyr,mcubus-node";
		reg = <0x10>;
	};

	mcu_b: mcu-b@11 {
		compatible = "zephyr,mcubus-node";
		reg = <0x11>;
	};

	mcu_c: mcu-c@12 {
		compatible = "zephyr,mcubus-node";
		reg = <0x12>;
	};
};
