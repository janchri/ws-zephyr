mainmenu "WirbelWind"

menu "WirbelWind"

module = WW
module-str = wirbelwind
source "subsys/logging/Kconfig.template.log_config"

config WW_SD_MOUNT_POINT
	string "Mount point of the SD card"
	default "/SD:"
	help
	  FatFs mount point. The part between '/' and ':' must match the
	  disk name of the SD card (disk-name of the flash-disk on native_sim,
	  "SD" for the sdmmc disk on real hardware).

config WW_PLAYLIST_MAX_TRACKS
	int "Maximum number of tracks per playlist"
	default 64

config WW_PLAYLIST_BUF_SIZE
	int "Buffer size for one playlist (JSON + strings)"
	default 6144

config WW_VOLUME_MAX
	int "Maximum volume step"
	default 20

config WW_VOLUME_DEFAULT
	int "Volume on boards without a volume potentiometer"
	default 8

config WW_BUTTON_LONG_MS
	int "Button: minimum duration of a long press (restart playlist) [ms]"
	default 1000

config WW_BUTTON_LONGLONG_MS
	int "Button: minimum duration of a very long press (reset all playlists) [ms]"
	default 10000

config WW_RESUME_SAVE_INTERVAL_S
	int "Interval for persisting the play position while playing [s]"
	default 30

config WW_CONTROLLER_STACK_SIZE
	int "Controller thread stack size"
	default 4096

config WW_PLAYER_STACK_SIZE
	int "Player thread stack size"
	default 32768
	help
	  minimp3 keeps its ~16 KiB scratch area on the stack.

config WW_PLAYER_PRIORITY
	int "Player thread priority"
	default 4

config WW_PLAYER_INBUF_SIZE
	int "MP3 input buffer size"
	default 16384

config WW_RFID
	bool "RFID reader: MFRC522 (rfid/)"
	default y
	depends on DT_HAS_NXP_MFRC522_ENABLED
	select SPI

if WW_RFID

config WW_RFID_INIT_PRIORITY
	int "MFRC522 driver init priority"
	default 90
	help
	  Must be after the SPI controller (and its emulators on native_sim).

config WW_RFID_POLL_MS
	int "Poll interval of the tag reader [ms]"
	default 250

config WW_RFID_REMOVE_POLLS
	int "Polls without the card before it counts as removed"
	default 3

endif

config WW_RFID_EMUL
	bool "Emulated MFRC522 with a card placed from the shell (native/mfrc522_emul.c)"
	default y if BOARD_NATIVE_SIM
	depends on WW_RFID && EMUL && SPI_EMUL && SHELL
	help
	  "ww tag place <uid>" / "ww tag remove" put a card on the emulated
	  reader, so the real driver and tag reader run in the simulation.

config WW_TAG_SHELL
	bool "Shell commands that post tag events directly (ww tag place/remove)"
	default y
	depends on SHELL && !WW_RFID_EMUL
	help
	  Bypasses the RFID reader, useful on real hardware to try playlists
	  without tags.

config WW_SIM
	bool "Simulated button and volume pot (native/sim.c)"
	default y if BOARD_NATIVE_SIM
	depends on SHELL && GPIO_EMUL && ADC_EMUL
	help
	  Shell commands "ww button" and "ww pot" that drive the controls of
	  the box through the GPIO and ADC emulators.

config WW_AUDIO_NATIVE
	bool "Host audio output on native_sim (native/audio.c)"
	default y
	depends on ARCH_POSIX
	help
	  Pipes the PCM to a host command (--audio_cmd) or writes it to a
	  file (--audio_file).

config WW_AUDIO_AC101
	bool "ESP32-A1S audio output: I2S + AC101 codec (esp32a1s/)"
	default y
	depends on DT_HAS_X_POWERS_AC101_ENABLED
	select I2S
	select I2C

if WW_AUDIO_AC101

config WW_AC101_HP_VOLUME
	int "AC101 headphone output level (0..63)"
	range 0 63
	default 40

config WW_AC101_SPK_VOLUME
	int "AC101 speaker output level (0..31)"
	range 0 31
	default 20

endif

config WW_WIFI_AP
	bool "WiFi hotspot at startup when no tag is on the box (wifi.c)"
	default y
	depends on WIFI && NET_DHCPV4_SERVER

if WW_WIFI_AP

config WW_WIFI_AP_SSID
	string "Hotspot name"
	default "music.Box"

config WW_WIFI_AP_PSK
	string "Hotspot password (8..63 characters, empty = open network)"
	default ""

config WW_WIFI_AP_IP
	string "Address of the box in the hotspot (/24)"
	default "192.168.4.1"

config WW_WIFI_AP_DELAY_MS
	int "Time after startup to wait for a tag before opening the hotspot [ms]"
	default 3000

endif

config WW_HTTP
	bool "Web interface"
	default y
	depends on HTTP_SERVER

if WW_HTTP

config WW_HTTP_PORT
	int "Web interface TCP port"
	default 80

config WW_HTTP_RESPONSE_SIZE
	int "Buffer for one JSON response"
	default 8192

endif

endmenu

source "Kconfig.zephyr"
