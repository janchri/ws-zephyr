#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	/* SD card replacement: FAT image backed by a host file */
	sdflashctrl: flash-controller@40000000 {
		compatible = "zephyr,sim-flash";
		reg = <0x40000000 DT_SIZE_M(64)>;
		#address-cells = <1>;
		#size-cells = <1>;
		erase-value = <0xff>;

		sdcard: flash@40000000 {
			compatible = "soc-nv-flash";
			/* names the command line option: --sdcard=<file> */
			label = "sdcard";
			erase-block-size = <4096>;
			write-block-size = <1>;
			reg = <0x40000000 DT_SIZE_M(64)>;

			partitions {
				compatible = "fixed-partitions";
				#address-cells = <1>;
				#size-cells = <1>;

				sd_partition: partition@0 {
					label = "sd";
					reg = <0x00000000 DT_SIZE_M(64)>;
				};
			};
		};
	};

	sd_disk {
		compatible = "zephyr,flash-disk";
		partition = <&sd_partition>;
		disk-name = "SD";
		cache-size = <4096>;
	};

	/* The button on the GPIO emulator: "ww button [ms]" */
	buttons {
		compatible = "gpio-keys";

		button: button {
			/* active high, because emulated inputs start at 0 (released) */
			gpios = <&gpio0 10 GPIO_ACTIVE_HIGH>;
			zephyr,code = <INPUT_KEY_NEXTSONG>;
		};
	};

	/* Volume potentiometer on the ADC emulator: "ww pot <0..100>" */
	volume_pot: volume_pot {
		compatible = "analog-axis";
		poll-period-ms = <50>;

		axis {
			io-channels = <&adc0 0>;
			in-min = <0>;
			in-max = <4095>;
			out-min = <0>;
			out-max = <1000>;
			zephyr,axis = <INPUT_ABS_THROTTLE>;
		};
	};
};

&adc0 {
	ref-internal-mv = <3300>;
	#address-cells = <1>;
	#size-cells = <0>;

	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
};
