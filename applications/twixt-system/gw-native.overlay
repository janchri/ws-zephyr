/* The console gateway: per board a UART over the bus, bridged to a serial port
 * to the laptop, host_<board>. The board's overlay (boards/) has the host ports,
 * disabled: a PTY on native_sim, USB CDC-ACM on the Raspberry Pi Pico.
 */

/ {
	bus_uart_pico: bus-uart-pico {
		compatible = "twixt,uart";
		peer = <&mcu_pico>;
	};

	bridge-pico {
		compatible = "zephyr,uart-bridge";
		peers = <&bus_uart_pico &host_pico>;
	};

	bus_uart_nrf: bus-uart-nrf {
		compatible = "twixt,uart";
		peer = <&mcu_nrf>;
	};

	bridge-nrf {
		compatible = "zephyr,uart-bridge";
		peers = <&bus_uart_nrf &host_nrf>;
	};

	bus_uart_esp32: bus-uart-esp32 {
		compatible = "twixt,uart";
		peer = <&mcu_esp32>;
	};

	bridge-esp32 {
		compatible = "zephyr,uart-bridge";
		peers = <&bus_uart_esp32 &host_esp32>;
	};
};

&host_pico {
	status = "okay";
};

&host_nrf {
	status = "okay";
};

&host_esp32 {
	status = "okay";
};
