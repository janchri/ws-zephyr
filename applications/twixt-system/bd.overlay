/* A board: its shell is on a UART over the bus to the gateway. Settings are in
 * NVS on settings_partition, littlefs on storage_partition is mounted at /lfs.
 * Included by each board overlay (boards/), which adds the bus, the partitions
 * and which MCU the board is (twixt,self).
 */

#ifndef TWIXT_GATEWAY_LABEL
#define TWIXT_GATEWAY_LABEL mcu_pico
#endif

/ {
	chosen {
		zephyr,shell-uart = &bus_uart;
		zephyr,settings-partition = &settings_partition;
	};

	bus_uart: bus-uart {
		compatible = "twixt,uart";
		peer = <&TWIXT_GATEWAY_LABEL>;
	};

	fstab {
		compatible = "zephyr,fstab";

		lfs: lfs {
			compatible = "zephyr,fstab,littlefs";
			mount-point = "/lfs";
			partition = <&storage_partition>;
			automount;
			read-size = <16>;
			prog-size = <16>;
			cache-size = <64>;
			lookahead-size = <32>;
			block-cycles = <512>;
		};
	};
};
