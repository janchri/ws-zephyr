# SPDX-License-Identifier: Apache-2.0
PROJECT_NAME = "@DOXY_DOC@"
OUTPUT_DIRECTORY = "@DOXY_OUT@"
INPUT = "@ZDOCS_PROJECT_BASE@/applications/warmguard/tests/main.c"
EXTRACT_ALL = YES
SOURCE_BROWSER = YES
GENERATE_HTML = YES
GENERATE_LATEX = NO
QUIET = YES
WARN_IF_UNDOCUMENTED = NO
STRIP_FROM_PATH = "@ZDOCS_PROJECT_BASE@"
ENABLE_PREPROCESSING = YES
MACRO_EXPANSION = YES
EXPAND_ONLY_PREDEF = YES

ALIASES += "testid{1}=\xrefitem testids \"Test ID\" \"Test IDs\" \1"
PREDEFINED = "ZTEST(suite, fn)=/** \ingroup suite */ void fn(void)" \
             "ZTEST_SUITE(suite, predicate, setup, before, after, teardown)="
